<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:O="clr-namespace:StreamerBotLib.Systems.Overlay.Models;assembly=StreamerBotLib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="StreamerBotLib.GUI.Data.OverlayServiceBulk"
    Title="{DynamicResource BulkLoad_Title}"
    Height="520"
    Width="680"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource FullBackground}"
    ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/StreamerBotLib;component/Culture/WindowMessages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid
        Background="{DynamicResource PartBackground}"
        Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="140" />
            <ColumnDefinition
                Width="*" />
            <ColumnDefinition
                Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_Overlay}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Text="{Binding OverlayType, Mode=OneWay}"
            IsReadOnly="True"
            Margin="0,0,0,8" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_Action}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Text="{Binding ActionValue, Mode=OneWay}"
            IsReadOnly="True"
            Margin="0,0,0,8" />
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_UserName}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,8" />
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_UseChatMsg}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <CheckBox
            Grid.Row="3"
            Grid.Column="1"
            IsChecked="{Binding UseChatMsg}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_Message}"
            VerticalAlignment="Top"
            Margin="0,4,0,8" />
        <TextBox
            Grid.Row="4"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            Height="60"
            VerticalScrollBarVisibility="Auto"
            Margin="0,0,0,8" />
        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_Duration}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="5"
            Grid.Column="1"
            Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
            Width="80"
            HorizontalAlignment="Left"
            Margin="0,0,0,8" />
        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_ImageFile}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="6"
            Grid.Column="1"
            x:Name="ImageFileTextBox"
            Text="{Binding ImageFile, UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,8,8"
            MouseDoubleClick="FileBrowser_TextBox_MouseDoubleClick" />
        <Button
            Grid.Row="6"
            Grid.Column="2"
            Content="{DynamicResource BulkLoad_Browse}"
            Width="80"
            Click="BrowseImage_Click"
            Margin="0,0,0,8"
            HorizontalAlignment="Right" />
        <CheckBox
            Grid.Row="7"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            x:Name="UseSameImageCheckBox"
            Content="{DynamicResource BulkLoad_UseSameImage}"
            IsChecked="True"
            Margin="0,0,0,12" />
        <TextBlock
            Grid.Row="8"
            Grid.Column="0"
            Text="{DynamicResource BulkLoad_MediaFile}"
            VerticalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBox
            Grid.Row="8"
            Grid.Column="1"
            x:Name="MediaFileTextBox"
            Text="{Binding MediaFile, UpdateSourceTrigger=PropertyChanged}"
            IsReadOnly="True"
            Margin="0,0,8,8"
            MouseDoubleClick="FileBrowser_TextBox_MouseDoubleClick" />
        <Button
            Grid.Row="8"
            Grid.Column="2"
            Content="{DynamicResource BulkLoad_Browse}"
            Width="80"
            Click="BrowseMedia_Click"
            Margin="0,0,0,8" />
        <!-- Spacer -->
        <Border
            Grid.Row="9" />
        <!-- Buttons -->
        <StackPanel
            Grid.Row="10"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                Content="{DynamicResource BulkLoad_CreateRecords}"
                Width="120"
                Height="32"
                Margin="0,0,10,0"
                Click="CreateRecords_Click"
                IsDefault="True" />
            <Button
                Content="{DynamicResource BulkLoad_Cancel}"
                Width="90"
                Height="32"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>