    <BOStatus:BotIdKey x:Key="BotIdKey_Twitch_Bot_Name"
                       Platform="Twitch"
                       BotType="BotAccount"
                       BotOperationType="ReadyToAuthorize"
                       NeedSecondAccount="False"
                       LockAnyBotActive="True"
                       BotStatusCategory="Label" />
