    <!-- Blue: no-scopes — streamer when second account -->
    <BOStatus:BotIdKey x:Key="BotIdKey_Twitch_Streamer_NoScopes_Token"
                       Platform="Twitch"
                       BotType="StreamerNoScopes"
                       BotOperationType="Authorize"
                       NeedSecondAccount="True"
