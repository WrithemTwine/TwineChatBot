    <BOStatus:BotIdKey x:Key="BotIdKey_Twitch_Bot_NoScopes_Token"
                       Platform="Twitch"
                       BotType="StreamerNoScopes"
                       BotOperationType="Authorize"
                       NeedSecondAccount="False"
                       BotStatusCategory="Label" />
