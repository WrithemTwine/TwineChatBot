    <BOStatus:BotIdKey x:Key="BotIdKey_Twitch_Scopes_SameAccount"
                       Platform="Twitch"
                       BotType="BotAccount"
                       BotOperationType="Authorize"
                       NeedSecondAccount="False"
                       BotStatusCategory="Label"
                       LabelOperationVisibility="True" />
