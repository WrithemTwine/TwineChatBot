    <!--#region Brushes - GradientCapable -->
    <RadialGradientBrush
        x:Key="FullBackground"
        GradientOrigin="0.5,0.5"
        Center="0.5,0.5"
        RadiusX="0.8"
        RadiusY="0.8">
        <GradientStop
            Color="#3A2F24"
            Offset="0.0" />
        <GradientStop
            Color="#2C2118"
            Offset="0.4" />
        <GradientStop
            Color="#1A1612"
            Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.Static.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Editable.Button.Background"
        EndPoint="0,1"
        StartPoint="0,0">
