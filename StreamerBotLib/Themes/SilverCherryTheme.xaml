    <Color x:Key="GlyphColor">#2A1420</Color>
    <Color x:Key="GlyphMouseOver">sc#1, 0.35, 0.15, 0.25</Color>
    <Color x:Key="BorderLightColor">#F8F4F8</Color>
    <Color x:Key="BorderMediumColor">#C090A8</Color>
    <Color x:Key="BorderDarkColor">#EB5C96</Color>
    <Color x:Key="PressedBorderLightColor">#EF6394</Color>
    <Color x:Key="PressedBorderDarkColor">#E73A80</Color>
    <Color x:Key="DisabledBorderLightColor">#E0D4DC</Color>
    <Color x:Key="DisabledBorderDarkColor">#C090A8</Color>
