    <Color x:Key="ScrollBarArrowFillColor">#2A1420</Color>
    <Color x:Key="ScrollBarThumbBorderColor">#EE75A6</Color>
    <Color x:Key="ScrollBarThumbBackgroundColor">#EF588D</Color>
    <Color x:Key="ScrollBarThumbTrackBackgroundColor">#FAABC9</Color>
    <Color x:Key="ScrollBarThumbMouseOverColor">#FF4081</Color>
    <Color x:Key="ScrollBarThumbPressedColor">#EB5C96</Color>
    <Color x:Key="BrightGoColor">#66BB6A</Color>
    <Color x:Key="GoColor">#43A047</Color>
    <Color x:Key="BrightStopColor">#EF5350</Color>
    <Color x:Key="StopColor">#E53935</Color>
    <Color x:Key="LabelBetaColor">#9B3EAC</Color>
    <!--#endregion-->
    <!--#region Brushes - GradientCapable -->
    <SolidColorBrush x:Key="FullBackground"
                     Color="{DynamicResource FullColor}" />
    <LinearGradientBrush x:Key="ComboBox.Static.Background"
                         EndPoint="0,1"
                         StartPoint="0,0">
        <GradientStop Color="{DynamicResource MediumColor}"
                      Offset="0.0" />
        <GradientStop Color="{DynamicResource LighterColor}"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBox.MouseOver.Background"
                         EndPoint="0,1"
                         StartPoint="0,0">
        <GradientStop Color="{DynamicResource LighterColor}"
                      Offset="0.0" />
        <GradientStop Color="{DynamicResource MediumColor}"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBox.MouseOver.Editable.Button.Background"
                         EndPoint="0,1"
                         StartPoint="0,0">
        <GradientStop Color="{DynamicResource LighterColor}"
                      Offset="0.0" />
        <GradientStop Color="{DynamicResource MediumColor}"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBox.Pressed.Background"
                         EndPoint="0,1"
                         StartPoint="0,0">
        <GradientStop Color="{DynamicResource MediumColor}"
                      Offset="0.0" />
        <GradientStop Color="{DynamicResource FullColor}"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ComboBox.Pressed.Editable.Button.Background"
                         EndPoint="0,1"
                         StartPoint="0,0">
        <GradientStop Color="{DynamicResource MediumColor}"
                      Offset="0.0" />
        <GradientStop Color="{DynamicResource FullColor}"
                      Offset="1.0" />
    </LinearGradientBrush>
    <!--#endregion-->
    <!--#region Brushes - Solid -->
    <SolidColorBrush x:Key="ControlBackground"
                     Color="{DynamicResource MediumColor}"
                     Opacity="{StaticResource ThemeBrushOpacity}" />
    <SolidColorBrush x:Key="PartBackground"
                     Color="{DynamicResource MediumColor}" />
    <SolidColorBrush x:Key="LightBackground"
                     Color="{DynamicResource LighterColor}" />
    <SolidColorBrush x:Key="ForegroundText"
                     Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="DisabledForegroundText"
                     Color="{DynamicResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="BrightGo"
                     Color="{DynamicResource BrightGoColor}" />
    <SolidColorBrush x:Key="BrightStop"
                     Color="{DynamicResource BrightStopColor}" />
    <SolidColorBrush x:Key="Go"
                     Color="{DynamicResource GoColor}" />
    <SolidColorBrush x:Key="Stop"
                     Color="{DynamicResource StopColor}" />
    <SolidColorBrush x:Key="LabelBeta"
                     Color="{DynamicResource LabelBetaColor}" />
    <SolidColorBrush x:Key="TabControlTabs"
                     Color="{DynamicResource MediumColor}" />
    <SolidColorBrush x:Key="Borders"
                     Color="{DynamicResource BorderMediumColor}" />
    <SolidColorBrush x:Key="ScrollBarBackground"
                     Color="{DynamicResource FullColor}" />
    <SolidColorBrush x:Key="ScrollBarForeground"
                     Color="{DynamicResource ScrollBarForegroundColor}" />
    <SolidColorBrush x:Key="ScrollBarArrowFill"
                     Color="{DynamicResource ScrollBarArrowFillColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBorder"
                     Color="{DynamicResource ScrollBarThumbBorderColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBackground"
                     Color="{DynamicResource ScrollBarThumbBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbTrackBackground"
                     Color="{DynamicResource ScrollBarThumbTrackBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbMouseOver"
                     Color="{DynamicResource ScrollBarThumbMouseOverColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbPressed"
                     Color="{DynamicResource ScrollBarThumbPressedColor}" />
    <SolidColorBrush x:Key="TabItemControlLight"
                     Color="{DynamicResource TabItemControlLightColor}" />
    <SolidColorBrush x:Key="TabItemControlMedium"
                     Color="{DynamicResource TabItemControlMediumColor}" />
    <SolidColorBrush x:Key="TabItemControlFull"
                     Color="{DynamicResource TabItemControlFullColor}" />
    <SolidColorBrush x:Key="DataGridAlternateColor"
                     Color="{DynamicResource DataGridAlternateColorColor}" />
    <SolidColorBrush x:Key="DataGridBackground"
                     Color="{DynamicResource DataGridBackgroundColor}" />
    <SolidColorBrush x:Key="DataGridCellFocus"
                     Color="{DynamicResource DataGridCellFocusColor}" />
    <SolidColorBrush x:Key="DataGridRowHeaderBackground"
                     Color="{DynamicResource DataGridRowHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="DataGridColumnHeaderBackground"
                     Color="{DynamicResource DataGridColumnHeaderBackgroundColor}" />
    <SolidColorBrush x:Key="DataGridRowSelected"
                     Color="{DynamicResource DataGridRowSelectedColor}" />
    <SolidColorBrush x:Key="DataGridRowSelectedInactive"
                     Color="{DynamicResource DataGridRowSelectedInactiveColor}" />
    <SolidColorBrush x:Key="DataGridRowHover"
                     Color="{DynamicResource DataGridRowHoverColor}" />
    <SolidColorBrush x:Key="ContextMenuBackground"
                     Color="{DynamicResource MediumColor}" />
    <SolidColorBrush x:Key="ContextMenuForeground"
                     Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="ListViewControlLight"
                     Color="{DynamicResource ListViewControlLightColor}" />
    <SolidColorBrush x:Key="ListViewControlMedium"
                     Color="{DynamicResource ListViewControlMediumColor}" />
    <SolidColorBrush x:Key="ListViewControlFull"
                     Color="{DynamicResource ListViewControlFullColor}" />
