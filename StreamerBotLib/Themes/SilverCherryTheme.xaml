    <Color x:Key="ForegroundColor">#52273F</Color>
    <Color x:Key="DisabledForegroundButtonColor">#A08090</Color>
    <Color x:Key="DataGridAlternateColorColor">#F0D8E4</Color>
    <Color x:Key="DataGridBackgroundColor">#F7BFD8</Color>
    <Color x:Key="DataGridRowHeaderBackgroundColor">#E8A0B8</Color>
    <Color x:Key="DataGridColumnHeaderBackgroundColor">#EC6C8F</Color>
    <Color x:Key="DataGridRowSelectedColor">#F45B91</Color>
    <Color x:Key="DataGridRowSelectedInactiveColor">#F48FB1</Color>
    <Color x:Key="DataGridRowHoverColor">#F5D0E0</Color>
    <Color x:Key="DataGridCellFocusColor">#F26F9C</Color>
    <Color x:Key="BorderColor">#C090A8</Color>
    <Color x:Key="ScrollBarRepeatButton">#E8A0B8</Color>
