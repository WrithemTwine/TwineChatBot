    <Color x:Key="ButtonDisabledBackgroundColor">#E0D4DC</Color>
    <Color x:Key="ButtonDisabledForegroundColor">#A08090</Color>
    <Color x:Key="ButtonDisabledBorderColor">#C090A8</Color>
    <Color x:Key="WindowColor">#F0E8F0</Color>
    <Color x:Key="ContentAreaColorLight">#F8F4F8</Color>
    <Color x:Key="ContentAreaColorDark">#E8D0DC</Color>
    <Color x:Key="DisabledControlLightColor">#F0E8F0</Color>
    <Color x:Key="DisabledControlDarkColor">#E0D4DC</Color>
