    <!--#region Brushes - GradientCapable -->
    <LinearGradientBrush
        x:Key="FullBackground"
        StartPoint="0,0"
        EndPoint="0,1">
        <GradientStop
            Color="#80DEEA"
            Offset="0.0" />
        <GradientStop
            Color="#00ACC1"
            Offset="0.4" />
        <GradientStop
            Color="#006064"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.Static.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Editable.Button.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.Pressed.Background"
