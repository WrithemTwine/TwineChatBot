    <!--#region Brushes - GradientCapable -->
    <RadialGradientBrush
        x:Key="FullBackground"
        MappingMode="Absolute"
        GradientOrigin="300,300"
        Center="300,300"
        RadiusX="400"
        RadiusY="400">
        <GradientStop
            Color="#78909C"
            Offset="0.0" />
        <GradientStop
            Color="#455A64"
            Offset="0.45" />
        <GradientStop
            Color="#263238"
            Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.Static.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Editable.Button.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.Pressed.Background"
