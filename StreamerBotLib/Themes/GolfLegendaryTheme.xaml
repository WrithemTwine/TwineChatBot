    <!--#region Brushes - GradientCapable -->
    <RadialGradientBrush
        x:Key="FullBackground"
        GradientOrigin="0.5,0.5"
        Center="0.5,0.5"
        RadiusX="0.55"
        RadiusY="0.55">
        <GradientStop
            Color="#FFFFFF"
            Offset="0.0" />
        <GradientStop
            Color="#C8E6C9"
            Offset="0.12" />
        <GradientStop
            Color="#2E7D32"
            Offset="0.4" />
        <GradientStop
            Color="#0D3B12"
            Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.Static.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource MediumColor}"
            Offset="0.0" />
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush
        x:Key="ComboBox.MouseOver.Background"
        EndPoint="0,1"
        StartPoint="0,0">
        <GradientStop
            Color="{DynamicResource LighterColor}"
            Offset="0.0" />
        <GradientStop
