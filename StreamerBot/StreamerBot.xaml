                                                                                    Height="20"
                                                                                    Width="50"
                                                                                    Text="{Binding RepeatChatCount}"
                                                                                    PreviewMouseLeftButtonDown="PreviewMouseLeftButton_SelectAll" />
                                                                                <TextBox
                                                                                    Grid.Row="3"
                                                                                    Grid.Column="1"
                                                                                    Height="20"
                                                                                    Width="50"
                                                                                    Text="{Binding RepeatUserMinutes}"
                                                                                    PreviewMouseLeftButtonDown="PreviewMouseLeftButton_SelectAll" />
