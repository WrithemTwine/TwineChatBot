                                    <Style
                                        TargetType="{x:Type Border}">
                                        <Setter
                                            Property="BorderThickness"
                                            Value="2" />
                                        <Setter
                                            Property="BorderBrush"
                                            Value="Black" />
                                    </Style>
                                </TabControl.Resources>
                                <TabItem
                                    Header="{DynamicResource GitHub_WikiDoc_Tab}">
                                    <DockPanel>
                                        <Label
                                            DockPanel.Dock="Top"
                                            Content="{DynamicResource GitHub_WikiDoc_Label}" />
                                        <Border>
                                            <DockPanel>
                                                <Button
                                                    DockPanel.Dock="Top"
                                                    Content="{DynamicResource Common_Reload}"
                                                    Width="59"
                                                    Height="29"
                                                    Click="WebView2Reload_Click"
                                                    HorizontalAlignment="Left" />
                                                <wv2:WebView2
                                                    DataContext=""
                                                    Source="{Binding Mode=OneWay, Source={x:Static StaticLib:OptionFlags.GitHubWikiLink}}" />
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </TabItem>
                                <TabItem
                                    Header="{DynamicResource GitHub_Stable_Tab}">
                                    <DockPanel>
                                        <Label
                                            DockPanel.Dock="Top"
                                            Content="{DynamicResource GitHub_Stable_Label}" />
                                        <Border>
                                            <DockPanel>
                                                <Button
                                                    DockPanel.Dock="Top"
                                                    Content="{DynamicResource Common_Reload}"
                                                    HorizontalAlignment="Left"
                                                    Height="29"
                                                    Click="WebView2Reload_Click" />
                                                <wv2:WebView2
                                                    DataContext=""
                                                    Source="{Binding Mode=OneWay, Source={x:Static StaticLib:OptionFlags.GitHubStableLink}}" />
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </TabItem>
                                <TabItem
                                    Header="{DynamicResource GitHub_Latest_Tab}">
                                    <DockPanel>
                                        <Label
                                            DockPanel.Dock="Top"
                                            Content="{DynamicResource GitHub_Latest_Label}" />
                                        <Border>
                                            <DockPanel>
                                                <Button
                                                    DockPanel.Dock="Top"
                                                    Content="{DynamicResource Common_Reload}"
                                                    HorizontalAlignment="Left"
                                                    Height="29"
                                                    Click="WebView2Reload_Click" />
                                                <wv2:WebView2
                                                    DataContext=""
                                                    Source="{Binding Mode=OneWay, Source={x:Static StaticLib:OptionFlags.GitHubLatestLink}}" />
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>

