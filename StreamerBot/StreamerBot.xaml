                                                                </CheckBox.ToolTip>
                                                                <TextBlock
                                                                    Text="{DynamicResource Options_Repeat_ShowOnReset}" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </GroupBox>
                                            <!-- Data Management (last group in this sub-tab) -->
