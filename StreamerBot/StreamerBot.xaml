                                                                                        Width="40" />
                                                                                    <ColumnDefinition
                                                                                        Width="65" />
                                                                                    <ColumnDefinition
                                                                                        Width="65" />
                                                                                    <ColumnDefinition
                                                                                        Width="65*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition
                                                                                        Height="25*" />
                                                                                    <RowDefinition
                                                                                        Height="25" />
                                                                                    <RowDefinition
                                                                                        Height="25" />
                                                                                    <RowDefinition
                                                                                        Height="25" />
                                                                                </Grid.RowDefinitions>
                                                                                <StackPanel
                                                                                    Grid.Row="0"
                                                                                    Grid.Column="0"
                                                                                    Grid.ColumnSpan="4"
