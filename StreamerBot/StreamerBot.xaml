                                                        Minimum="0"
                                                        SmallChange="5"
                                                        SelectionStart="5"
                                                        SelectionEnd="3600"
                                                        Margin="10,0"
                                                        IsSnapToTickEnabled="True"
                                                        LostFocus="Settings_LostFocus"
